[Unit]
Description=Hourly NapMem consolidation sweep

[Timer]
# OnCalendar (not monotonic OnUnitActiveSec) so Persistent=true actually
# applies: a sweep window missed while the box was down runs at next boot.
OnCalendar=hourly
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
