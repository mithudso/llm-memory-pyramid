# Documentation only: programs do not automatically load dotenv files.
# Export only settings needed for the operation you intend to run.

# Embedding backend: hashed is offline; ollama/unset probes configured hosts.
NAPMEM_EMBED_BACKEND=hashed
# Single embedding host override / weighted list (alternatives).
NAPMEM_OLLAMA_URL=http://127.0.0.1:11434
NAPMEM_OLLAMA_URLS=http://127.0.0.1:11434=1
# All embedding hosts must serve the same model.
NAPMEM_OLLAMA_MODEL=mxbai-embed-large
# Chat extraction URL=model chain used by auto/ollama modes.
NAPMEM_OLLAMA_CHAT=http://127.0.0.1:11434=qwen3.5:35b
# Colon-separated vetted roots; unset means only the watch directory.
NAPMEM_ALLOWED_ROOTS=/path/to/vetted/memory
# Sweep wrapper data root, checkout and mode.
NAPMEM_HOME=/path/to/napmem-data
NAPMEM_REPO=/path/to/llm-memory-pyramid
NAPMEM_EXTRACTION=heuristic
# MCP server store.
NAPMEM_PYRAMID=/path/to/napmem_pyramid.json
# SSH target; unset uses ~/.napmem/remote_host, then local-only.
NAPMEM_REMOTE_HOST=user@host.example
# Remote paths may expand the remote shell's $HOME.
NAPMEM_REMOTE_PYRAMID=$HOME/.napmem/napmem_pyramid.json
NAPMEM_REMOTE_REPO=$HOME/dev/llm-memory-pyramid
# Local mirror and deadlines in seconds.
NAPMEM_MIRROR_DIR=/path/to/napmem-mirror
NAPMEM_MIRROR_MAX_AGE=3600
NAPMEM_SSH_TIMEOUT=5
NAPMEM_REMOTE_REQUEST_TIMEOUT=60
# Embedding host used by the local fallback.
NAPMEM_FALLBACK_OLLAMA=http://127.0.0.1:11434
# Optional SDK credential: never commit a real value.
ANTHROPIC_API_KEY=replace-with-sdk-credential
# Shared client defaults when NAPMEM embedding hosts are unset.
OLLAMA_URLS=http://127.0.0.1:11434=1
OLLAMA_HOST=http://127.0.0.1:11434
# GitHub Actions secret: dedicated read-only dependency deploy key.
OLLAMA_CLIENT_DEPLOY_KEY=configure-as-actions-secret
